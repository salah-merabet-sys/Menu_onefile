# Netlify-style _headers — GitHub Pages does NOT support this file natively,
# but it costs nothing to include it for teams who later migrate to Netlify/Vercel.
#
# For GitHub Pages the cache-busting is handled entirely in menu.js via
# the ?v=<timestamp> query param + Cache-Control: no-cache request header,
# which forces GitHub's CDN to revalidate on every request.

/data/menu.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable
